# PostgreSQL connection string used by the database layer (later tasks).
# Local example: postgresql://postgres:postgres@localhost:5432/client_portal
DATABASE_URL=

# Secret used to sign sessions/JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of the portal, e.g. http://localhost:3000
APP_URL=http://localhost:3000

# ---- Object storage (future tasks; optional for now) ----
# S3-compatible endpoint, e.g. https://s3.us-east-1.amazonaws.com
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Public (safe to expose to the browser) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
